# Set default behavior to automatically normalize line endings to LF in repository
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to LF on checkout
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Denote all binary files that should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
